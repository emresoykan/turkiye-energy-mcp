HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=0.5
