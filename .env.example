CACHE_DAILY_TTL_SECONDS=600
CACHE_MONTHLY_TTL_SECONDS=21600
CACHE_HISTORICAL_TTL_SECONDS=86400
CACHE_PLANTS_TTL_SECONDS=86400

TEIAS_BASE_URL=https://www.teias.gov.tr
TEIAS_FILE_BASE_URL=https://webim.teias.gov.tr
TEIAS_ANNUAL_REPORT_YEAR=2024
